# Database — use your Supabase "Transaction" / pooled connection string in production.
# Local Phase 0/1 verification uses Homebrew Postgres until a Supabase project is linked.
DATABASE_URL=postgresql://localhost:5432/multiplayer_ai

# Clerk — create an application at https://dashboard.clerk.com and paste keys here
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Local API testing without Clerk (curl/Postman).
# TODO(security): MUST be false/unset before any real deployment — see README.md
ALLOW_DEV_AUTH=true
# Send header: x-dev-clerk-id (required), optional x-dev-user-name, x-dev-user-email
