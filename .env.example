# Database — use your Supabase "Transaction" / pooled connection string in production.
# Local Phase 0/1 verification uses Homebrew Postgres until a Supabase project is linked.
DATABASE_URL=postgresql://localhost:5432/multiplayer_ai

# Clerk — required for Step 5 browser sign-in (https://dashboard.clerk.com)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_aGVscGVkLXRvYWQtMTY5OS5jbGVyay5hY2NvdW50cy5kZXYk
CLERK_SECRET_KEY=sk_test_lD3o5uCGz6bhBpP1LTZOuHSEYF0AQT1lSNH3u5n6gS
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Local API testing without Clerk (curl/Postman).
# TODO(security): MUST be false/unset before any real deployment — see README.md
ALLOW_DEV_AUTH=true
# Send header: x-dev-clerk-id (required), optional x-dev-user-name, x-dev-user-email

REDIS_URL=redis://127.0.0.1:6379

# Mock AI — default ON (any value other than "false"). Set to false only after adding a real Anthropic key.
MOCK_AI_RESPONSES=true

# Anthropic — required for the real agent loop when MOCK_AI_RESPONSES=false
# Do not rely on shell ANTHROPIC_BASE_URL if it points at Ollama; the app uses api.anthropic.com unless MULTIPLAYER_AI_ANTHROPIC_BASE_URL is set.
ANTHROPIC_API_KEY=
# Optional override (default: claude-sonnet-5)
# ANTHROPIC_MODEL=claude-sonnet-5
# MULTIPLAYER_AI_ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

# Inngest — optional for local Step 12 schedule wire (POST /api/sessions/:id/handoff works without it).
# For local serve: set INNGEST_DEV=1 and run `npx inngest-cli@latest dev` against /api/inngest.
INNGEST_DEV=1
# INNGEST_EVENT_KEY=
# INNGEST_SIGNING_KEY=

# Tool Mesh — encrypt connector secrets at rest (AES-256-GCM).
# Prefer a 32-byte key as 64 hex chars or base64. Optional in local dev (deterministic fallback).
# TOOL_AUTH_ENCRYPTION_KEY=

# Guest magic-link cookies (Step 20). Falls back to TOOL_AUTH_ENCRYPTION_KEY / CLERK_SECRET_KEY.
# GUEST_SESSION_SECRET=

# GitHub OAuth (Step 14) — required to Connect GitHub in /settings/tools
# Create an OAuth App at https://github.com/settings/developers
# Homepage URL: http://localhost:3000
# Authorization callback URL: http://localhost:3000/api/org/tools/github/callback
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# APP_URL=http://localhost:3000
